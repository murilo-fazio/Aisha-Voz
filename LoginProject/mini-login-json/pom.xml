<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.3</version>
		<relativePath/>
	</parent>

	<groupId>com.example</groupId>
	<artifactId>mini-login-json</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>mini-login-json</name>
	<description>Mini projeto de login com JSON</description>

	<properties>
		<java.version>25</java.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!--
				O spring-boot-starter-parent define a propriedade
				testcontainers.version (2.0.3 nesta versao do Boot) mas nao
				gerencia os artefatos do Testcontainers. Importar o BOM deles
				mantem as versoes alinhadas com o resto do Spring Boot sem
				fixar numero nenhum a mao.
			-->
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>

		<!-- Persistencia: JPA/Hibernate sobre Postgres -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Driver do Postgres (so precisa existir em tempo de execucao) -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
			Flyway: dono do esquema do banco. O Hibernate nunca altera schema.

			No Spring Boot 4 a autoconfiguracao do Flyway saiu do
			spring-boot-autoconfigure e virou o modulo spring-boot-flyway,
			trazido por este starter. So o flyway-core NAO basta: sem o starter
			as migracoes nunca rodam no boot.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>

		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>

		<!-- Modulo do Flyway especifico para Postgres (obrigatorio a partir do Flyway 10) -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- Suporte a testes (JUnit 5 + @SpringBootTest). Sem isto o test-compile quebra. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			MockMvc para testar os controllers pelo caminho HTTP (inclusive o
			render dos templates Thymeleaf, cujos erros de expressao so
			aparecem em tempo de execucao).

			No Spring Boot 4 o @AutoConfigureMockMvc saiu do
			spring-boot-test-autoconfigure e passou a viver neste modulo, no
			pacote org.springframework.boot.webmvc.test.autoconfigure. O
			starter-test sozinho NAO o traz.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			Testcontainers: sobe um Postgres 17 real e descartavel para os testes.

			Nao usamos H2: o H2 nao entende o SQL das migracoes escritas para
			Postgres (GENERATED BY DEFAULT AS IDENTITY, indice unico sobre
			lower(email)), entao passaria em testes que quebrariam em producao.
			Com um Postgres de verdade, cada execucao valida tambem as migracoes
			do Flyway e o ddl-auto=validate contra o esquema real.

			Requer um runtime de containers ativo (Docker ou Podman).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>