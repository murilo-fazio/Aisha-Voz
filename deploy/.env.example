# ==============================================================================
# Aisha — variaveis do ambiente de PRODUCAO (servidor Umbrel)
# ==============================================================================
# No servidor:
#     cp .env.example .env
#     chmod 600 .env        # so o dono le: aqui moram todas as senhas
#
# Este modelo e versionado; o .env real NUNCA vai para o Git.
# Variaveis OBRIGATORIAS nao tem default: o compose recusa subir sem elas.
# ==============================================================================

# ── Dominio ──────────────────────────────────────────────────────────────────
# OBRIGATORIA. Sem https:// e sem barra no fim. Ex.: aisha.com.br
AISHA_DOMAIN=aisha.com.br

# ── Versao das imagens ───────────────────────────────────────────────────────
# "latest" = ultimo build da main. Para voltar a uma versao anterior, use a tag
# sha-xxxxxxx que o GitHub Actions publica e rode ./scripts/deploy.sh de novo.
AISHA_TAG=latest

# ── Banco de dados ───────────────────────────────────────────────────────────
POSTGRES_DB=aisha
POSTGRES_USER=aisha
# OBRIGATORIA. Gere com:  openssl rand -hex 24
# (hex, e nao base64: sem '/', '+' ou '=' para quebrar URL ou shell)
POSTGRES_PASSWORD=

# ── Servico de IA ────────────────────────────────────────────────────────────
# OBRIGATORIA. Gere com:  openssl rand -hex 32
AI_INTERNAL_TOKEN=
# OBRIGATORIA. https://openrouter.ai/keys
# IMPORTANTE: o site fica aberto na internet e qualquer pessoa pode se cadastrar.
# Crie uma chave SO para producao e defina um limite de credito nela no painel
# do OpenRouter — e o que impede uma conta de esvaziar o saldo.
OPENROUTER_API_KEY=
CHAT_MODEL=google/gemini-3.8-flash
AI_REASONING_EFFORT=low
AI_MAX_TOKENS=800
AI_SUMMARY_MAX_TOKENS=500
# Voz: os dois endpoints usam a mesma chave OpenRouter do chat.
STT_MODEL=openai/whisper-1
TTS_MODEL=microsoft/mai-voice-2.1
TTS_VOICE=pt-BR-Luana:MAI-Voice-2.1
AUDIO_TIMEOUT_SECONDS=120
AI_READ_TIMEOUT_SECONDS=150
VOICE_MAX_AUDIO_MB=10
TTS_MAX_CHARS=4000

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# OBRIGATORIA. Painel da Cloudflare → Zero Trust → Networks → Tunnels → criar
# tunel "Cloudflared" → copiar o token (o texto longo depois de --token).
CLOUDFLARE_TUNNEL_TOKEN=

# ── Backup ───────────────────────────────────────────────────────────────────
# Horario no formato do cron (padrao: todo dia as 03:00).
BACKUP_CRON=0 3 * * *
# Quantos dias de backup manter em ./backups.
BACKUP_KEEP_DAYS=14
TZ=America/Sao_Paulo
